{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Humble Library",
  "version": "0.2.3",
  "identifier": "ru.humblelibrary.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Nyanma",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
